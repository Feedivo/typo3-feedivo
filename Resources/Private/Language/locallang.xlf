<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="EXT:feedivo/Resources/Private/Language/locallang.xlf" date="2026-09-14T12:00:00Z" product-name="feedivo">
        <header/>
        <body>
            <trans-unit id="module.title" resname="module.title"><source>Feedivo</source></trans-unit>
            <trans-unit id="module.connect" resname="module.connect"><source>Connect with Feedivo</source></trans-unit>
            <trans-unit id="module.intro" resname="module.intro"><source>Create a TYPO3 connection in your Feedivo account (Connections → TYPO3) and enter its connection ID here. Afterwards editors pick a feed in the content element "Feedivo feed".</source></trans-unit>
            <trans-unit id="module.integrationId" resname="module.integrationId"><source>Connection ID</source></trans-unit>
            <trans-unit id="module.integrationIdHint" resname="module.integrationIdHint"><source>Shown on the connection's page in Feedivo. Keep it private: whoever knows it can move the connection to another website.</source></trans-unit>
            <trans-unit id="module.site" resname="module.site"><source>Website</source></trans-unit>
            <trans-unit id="module.siteHint" resname="module.siteHint"><source>Feedivo allows the feed on this site's domain. Further domains (for example per language) can be added on the connection's page in Feedivo.</source></trans-unit>
            <trans-unit id="module.connectButton" resname="module.connectButton"><source>Connect</source></trans-unit>
            <trans-unit id="module.connected" resname="module.connected"><source>Connected with Feedivo</source></trans-unit>
            <trans-unit id="module.connectionName" resname="module.connectionName"><source>Connection</source></trans-unit>
            <trans-unit id="module.siteUrl" resname="module.siteUrl"><source>Website</source></trans-unit>
            <trans-unit id="module.connectedAt" resname="module.connectedAt"><source>Connected on</source></trans-unit>
            <trans-unit id="module.feeds" resname="module.feeds"><source>Available feeds</source></trans-unit>
            <trans-unit id="module.noFeeds" resname="module.noFeeds"><source>This connection covers no feeds yet. Assign feeds to it in Feedivo.</source></trans-unit>
            <trans-unit id="module.howToUse" resname="module.howToUse"><source>Add the content element "Feedivo feed" to a page and pick one of these feeds. Layout, columns and filters are set in Feedivo and apply immediately.</source></trans-unit>
            <trans-unit id="module.disconnect" resname="module.disconnect"><source>Disconnect</source></trans-unit>
            <trans-unit id="module.disconnectHint" resname="module.disconnectHint"><source>Feeds on your pages stop rendering until you connect again. Nothing is deleted in Feedivo.</source></trans-unit>
            <trans-unit id="module.footer" resname="module.footer"><source>Feedivo extension %1$s · Feedivo at %2$s ·</source></trans-unit>
            <trans-unit id="message.invalidId" resname="message.invalidId"><source>Please enter the connection ID exactly as shown in Feedivo.</source></trans-unit>
            <trans-unit id="message.unknownId" resname="message.unknownId"><source>Feedivo does not know this connection ID. Check that it belongs to a TYPO3 connection.</source></trans-unit>
            <trans-unit id="message.failed" resname="message.failed"><source>Connecting failed: %s</source></trans-unit>
            <trans-unit id="message.connected" resname="message.connected"><source>Connected with "%s". Editors can now pick feeds in the content element.</source></trans-unit>
            <trans-unit id="message.disconnected" resname="message.disconnected"><source>Disconnected from Feedivo.</source></trans-unit>
            <trans-unit id="feed.notConnected" resname="feed.notConnected"><source>Not connected – connect the installation under Site Management → Feedivo</source></trans-unit>
            <trans-unit id="feed.unavailable" resname="feed.unavailable"><source>Feeds could not be loaded: %s</source></trans-unit>
            <trans-unit id="feed.empty" resname="feed.empty"><source>The connection covers no feeds – assign feeds in Feedivo</source></trans-unit>
            <trans-unit id="preview.feed" resname="preview.feed"><source>Feedivo feed:</source></trans-unit>
            <trans-unit id="preview.notConnected" resname="preview.notConnected"><source>Not connected with Feedivo – nothing will render. Connect under Site Management → Feedivo.</source></trans-unit>
            <trans-unit id="preview.noFeed" resname="preview.noFeed"><source>No feed selected – nothing will render.</source></trans-unit>
        </body>
    </file>
</xliff>
